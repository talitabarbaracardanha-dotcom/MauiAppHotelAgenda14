<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelAgenda14.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20" Spacing="15">

        <Label Text="✓" 
               TextColor="Green" 
               FontSize="50" 
               HorizontalTextAlignment="Center" 
               FontAttributes="Bold"/>

        <Label Text="Reserva Confirmada!" 
               TextColor="Gray"
               FontSize="16"
               HorizontalTextAlignment="Center"
               CharacterSpacing="1"/>

        <Label Text="{Binding QuartoSelecionado.Descricao}" 
               TextColor="{StaticResource Primary}" 
               FontFamily="Kalam"
               FontSize="32"
               Margin="0,0,0,10"
               HorizontalTextAlignment="Center"/>

        <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="White"
                Stroke="#EAEAEA"
                Padding="20"
                Margin="5,0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">

                <Grid ColumnDefinitions="*, *" Padding="5,0">
                    <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                        <Label Text="Adultos:" FontAttributes="Bold" TextColor="Gray" />
                        <Label Text="{Binding QntAdultos}" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                        <Label Text="Crianças:" FontAttributes="Bold" TextColor="Gray" />
                        <Label Text="{Binding QntCriancas}" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />

                <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="5" HorizontalOptions="Fill">
                    <Label Grid.Row="0" Grid.Column="0" Text="Check-in" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="Check-out" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="Estadia" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="{Binding DataCheckin, StringFormat='{}{0:dd/MM/yyyy}'}"
                           TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="1" 
                           Text="{Binding DataCheckout, StringFormat='{}{0:dd/MM/yyyy}'}"
                           TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="2" 
                           Text="{Binding Estadia}"
                           TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />

                <VerticalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,5,0,0">
                    <Label Text="VALOR TOTAL DA ESTADIA" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" CharacterSpacing="1"/>
                    <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}" 
                           TextColor="DarkGreen"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar para a Tela Inicial" 
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                Margin="5,15,5,0"
                HorizontalOptions="Fill"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>